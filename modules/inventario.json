{
  "id": "inventario",
  "name": "Inventario",
  "version": "1.8.0",
  "icon": "boxes",
  "description": "Existencias por almacén y producto, y movimientos de entrada, salida, ajuste y traspaso. Las recepciones confirmadas de Compras generan sus entradas solas.",
  "requires": ["compras"],
  "plan": {
    "description": "Módulo de Inventario 1.0.0",
    "operations": [
      { "op": "createEntity", "group": "Inventario", "name": "Existencia", "label": "Existencia", "labelPlural": "Existencias", "icon": "boxes",
        "description": "Cantidad disponible por almacén y producto. La calcula el sistema a partir de los movimientos.",
        "fields": [
          { "name": "Almacen", "label": "Almacén", "type": "reference", "referenceEntity": "Almacen", "editable": false },
          { "name": "Producto", "label": "Producto", "type": "reference", "referenceEntity": "Producto", "editable": false },
          { "name": "Cantidad", "label": "Existencia", "type": "decimal", "precision": 18, "scale": 2, "editable": false, "defaultValue": "0" },
          { "name": "StockMinimo", "label": "Stock mínimo", "type": "formula", "resultType": "decimal", "precision": 18, "scale": 2, "formula": "Producto.StockMinimo" },
          { "name": "BajoMinimo", "label": "Bajo mínimo", "type": "formula", "resultType": "boolean", "formula": "Cantidad < Producto.StockMinimo" },
          { "name": "Clave", "label": "Clave", "type": "formula", "resultType": "text", "showInList": false, "formula": "Almacen.Clave & ' · ' & Producto.Clave" }
        ] },
      { "op": "updateEntity", "entity": "Existencia", "displayField": "Clave" },
      { "op": "setRules", "entity": "Existencia", "rules": [
          { "name": "LaCreaElSistema", "assert": "NOT ISBLANK(Almacen) AND NOT ISBLANK(Producto)", "message": "Las existencias las crea el sistema con cada movimiento de inventario." },
          { "name": "SinNegativos", "field": "Cantidad", "assert": "Cantidad >= 0", "message": "No hay existencias suficientes: la operación dejaría el inventario en negativo." }
        ] },

      { "op": "createEntity", "group": "Inventario", "name": "MovimientoInventario", "label": "Movimiento de inventario", "labelPlural": "Movimientos de inventario", "icon": "arrow-left-right", "displayField": "Folio",
        "description": "Entradas, salidas, ajustes y traspasos. Un movimiento aplicado no se edita ni se elimina.",
        "fields": [
          { "name": "Folio", "label": "Folio", "type": "autonumber", "prefix": "MOV-", "padding": 6 },
          { "name": "Fecha", "label": "Fecha", "type": "date", "required": true, "editable": false, "defaultValue": "TODAY()" },
          { "name": "Tipo", "label": "Tipo", "type": "choice", "required": true, "options": ["Entrada", "Salida", "Ajuste", "Traspaso salida", "Traspaso entrada"] },
          { "name": "Almacen", "label": "Almacén", "type": "reference", "referenceEntity": "Almacen", "required": true },
          { "name": "Producto", "label": "Producto", "type": "reference", "referenceEntity": "Producto", "required": true },
          { "name": "Cantidad", "label": "Cantidad", "type": "decimal", "precision": 18, "scale": 2, "required": true },
          { "name": "Efecto", "label": "Efecto en existencia", "type": "formula", "resultType": "decimal", "precision": 18, "scale": 2,
            "formula": "IF(Tipo IN ('Salida', 'Traspaso salida'), -ABS(Cantidad), IF(Tipo = 'Ajuste', Cantidad, ABS(Cantidad)))" },
          { "name": "Referencia", "label": "Documento origen", "type": "text", "maxLength": 40, "editable": false },
          { "name": "Notas", "label": "Notas", "type": "longtext", "showInList": false }
        ] },
      { "op": "setRules", "entity": "MovimientoInventario", "rules": [
          { "name": "CantidadNoCero", "field": "Cantidad", "assert": "Cantidad <> 0", "message": "La cantidad no puede ser cero." },
          { "name": "SoloAjusteNegativo", "field": "Cantidad", "when": "Tipo <> 'Ajuste'", "assert": "Cantidad > 0", "message": "La cantidad debe ser mayor a cero (solo un ajuste puede ser negativo)." },
          { "name": "AjusteSupervisor", "field": "Tipo", "when": "Tipo = 'Ajuste'", "assert": "HASROLE('Supervisor de inventario') OR HASROLE('Administrador')",
            "message": "Solo el supervisor de inventario registra ajustes." },
          { "name": "TraspasoConDocumento", "field": "Tipo", "when": "Tipo IN ('Traspaso salida', 'Traspaso entrada')", "assert": "NOT ISBLANK(Referencia)",
            "message": "Los traspasos se registran con un documento de traspaso." }
        ] },
      { "op": "setWorkflow", "entity": "MovimientoInventario", "workflow": {
          "initial": "Aplicado",
          "states": [ { "name": "Aplicado", "label": "Aplicado", "color": "success", "editable": false } ],
          "transitions": []
        } },
      { "op": "setAutomations", "entity": "MovimientoInventario", "automations": [
          { "name": "ActualizarExistencia", "label": "Actualizar la existencia", "on": "create",
            "actions": [
              { "type": "rollup", "entity": "Existencia", "match": [ { "field": "Almacen", "source": "Almacen" }, { "field": "Producto", "source": "Producto" } ],
                "createMissing": true, "field": "Cantidad", "sum": "Efecto" }
            ] }
        ] },

      { "op": "createEntity", "group": "Inventario", "name": "Traspaso", "label": "Traspaso", "labelPlural": "Traspasos", "icon": "arrow-right-left", "displayField": "Folio",
        "description": "Mueve mercancía entre almacenes: al aplicarse genera una salida en el origen y una entrada en el destino.",
        "fields": [
          { "name": "Folio", "label": "Folio", "type": "autonumber", "prefix": "TRA-", "padding": 6 },
          { "name": "Fecha", "label": "Fecha", "type": "date", "required": true, "editable": false, "defaultValue": "TODAY()" },
          { "name": "AlmacenOrigen", "label": "Almacén origen", "type": "reference", "referenceEntity": "Almacen", "required": true },
          { "name": "AlmacenDestino", "label": "Almacén destino", "type": "reference", "referenceEntity": "Almacen", "required": true },
          { "name": "Notas", "label": "Notas", "type": "longtext", "showInList": false }
        ] },
      { "op": "createEntity", "group": "Inventario", "name": "TraspasoPartida", "label": "Partida de traspaso", "labelPlural": "Partidas de traspaso", "icon": "list",
        "fields": [
          { "name": "Traspaso", "label": "Traspaso", "type": "parent", "referenceEntity": "Traspaso" },
          { "name": "Producto", "label": "Producto", "type": "reference", "referenceEntity": "Producto", "required": true },
          { "name": "Cantidad", "label": "Cantidad", "type": "decimal", "precision": 18, "scale": 2, "required": true }
        ] },
      { "op": "setRules", "entity": "TraspasoPartida", "rules": [
          { "name": "CantidadPositiva", "field": "Cantidad", "assert": "Cantidad > 0", "message": "La cantidad debe ser mayor a cero." }
        ] },
      { "op": "addField", "entity": "Traspaso", "field": { "name": "Partidas", "label": "Partidas", "type": "lines", "childEntity": "TraspasoPartida" } },
      { "op": "addField", "entity": "Traspaso", "field": { "name": "TotalPiezas", "label": "Total a traspasar", "type": "formula", "resultType": "decimal", "precision": 18, "scale": 2, "formula": "SUM(Partidas.Cantidad)" } },
      { "op": "setRules", "entity": "Traspaso", "rules": [
          { "name": "AlmacenesDistintos", "field": "AlmacenDestino", "assert": "AlmacenOrigen <> AlmacenDestino", "message": "El almacén destino debe ser distinto del origen." }
        ] },
      { "op": "setWorkflow", "entity": "Traspaso", "workflow": {
          "initial": "Borrador",
          "states": [
            { "name": "Borrador", "label": "Borrador", "color": "neutral", "editable": true },
            { "name": "Aplicado", "label": "Aplicado", "color": "success", "editable": false },
            { "name": "Cancelado", "label": "Cancelado", "color": "danger", "editable": false }
          ],
          "transitions": [
            { "name": "aplicar", "label": "Aplicar traspaso", "from": ["Borrador"], "to": "Aplicado", "icon": "check", "variant": "primary",
              "roles": ["Almacenista", "Supervisor de inventario"],
              "when": "COUNT(Partidas) > 0", "whenMessage": "Agrega al menos una partida." },
            { "name": "cancelar", "label": "Cancelar", "from": ["Borrador"], "to": "Cancelado", "icon": "ban", "variant": "danger",
              "roles": ["Almacenista", "Supervisor de inventario"], "requireComment": true }
          ]
        } },
      { "op": "setAutomations", "entity": "Traspaso", "automations": [
          { "name": "MoverMercancia", "label": "Mover la mercancía entre almacenes", "on": "enterState", "state": "Aplicado",
            "actions": [
              { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                  { "field": "Tipo", "value": "'Traspaso salida'" }, { "field": "Almacen", "value": "Traspaso.AlmacenOrigen" },
                  { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Traspaso.Folio" } ] },
              { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                  { "field": "Tipo", "value": "'Traspaso entrada'" }, { "field": "Almacen", "value": "Traspaso.AlmacenDestino" },
                  { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Traspaso.Folio" } ] }
            ] }
        ] },

      { "op": "setAutomations", "entity": "Recepcion", "merge": true, "automations": [
          { "name": "EntradaAlmacen", "label": "Registrar la entrada al almacén", "on": "enterState", "state": "Confirmada",
            "actions": [
              { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                  { "field": "Tipo", "value": "'Entrada'" }, { "field": "Almacen", "value": "Recepcion.Almacen" },
                  { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Recepcion.Folio" } ] }
            ] }
        ] }
    ]
  },
  "upgrades": [
    { "version": "1.1.0",
      "description": "Las existencias las administra el sistema: no se ofrecen ni se aceptan altas, cambios o bajas a mano, ni siquiera del administrador.",
      "plan": { "description": "Inventario 1.1.0", "operations": [
        { "op": "setSecurity", "entity": "Existencia", "security": { "systemManaged": true } }
      ] } },
    { "version": "1.2.0",
      "description": "Reportes de existencias y movimientos, vista «Bajo mínimo» y el tablero «Inventario».",
      "plan": { "description": "Inventario 1.2.0", "operations": [
        { "op": "setViews", "entity": "Existencia", "views": [
            { "name": "BajoMinimo", "label": "Bajo mínimo", "filters": [{ "field": "BajoMinimo", "op": "eq", "value": true }], "sort": "Cantidad", "dir": "asc" }
          ] },
        { "op": "setReports", "entity": "Existencia", "reports": [
            { "name": "PorAlmacen", "label": "Existencias por almacén", "groupBy": [{ "field": "Almacen" }],
              "measures": [{ "fn": "sum", "field": "Cantidad", "label": "Unidades" }, { "fn": "count", "label": "Productos" }], "chart": "bar" },
            { "name": "BajoMinimo", "label": "Productos bajo mínimo", "measures": [{ "fn": "count", "label": "Productos" }], "filter": "BajoMinimo" }
          ] },
        { "op": "setReports", "entity": "MovimientoInventario", "reports": [
            { "name": "PorTipo", "label": "Movimientos por tipo", "groupBy": [{ "field": "Tipo" }], "measures": [{ "fn": "count", "label": "Movimientos" }], "chart": "pie" },
            { "name": "PorMes", "label": "Movimientos por mes", "groupBy": [{ "field": "Fecha", "period": "month", "label": "Mes" }, { "field": "Tipo" }],
              "measures": [{ "fn": "count", "label": "Movimientos" }, { "fn": "sum", "field": "Efecto", "label": "Efecto en existencia" }] }
          ] },
        { "op": "setDashboard", "dashboard": { "name": "Inventario", "label": "Inventario", "icon": "warehouse",
            "description": "Existencias por almacén, productos bajo mínimo y movimientos.",
            "widgets": [
              { "type": "kpi", "entity": "Existencia", "report": "BajoMinimo" },
              { "type": "chart", "entity": "MovimientoInventario", "report": "PorTipo" },
              { "type": "chart", "entity": "Existencia", "report": "PorAlmacen", "wide": true },
              { "type": "table", "entity": "MovimientoInventario", "report": "PorMes", "wide": true }
            ] } }
      ] } },
    { "version": "1.3.0",
      "description": "Integraciones: rol de servicio «Integración de tienda» y webhook «Existencia actualizada», que avisa a la tienda en línea cada vez que cambia una existencia. El destino se configura en cada entorno.",
      "roles": [
        { "name": "Integración de tienda", "description": "Rol de servicio: la tienda en línea consulta existencias por producto y almacén.", "canManageModel": false, "canManageUsers": false, "canViewAudit": false,
          "permissions": [
            { "entity": "Existencia", "canRead": true, "canCreate": false, "canUpdate": false, "canDelete": false },
            { "entity": "Producto", "canRead": true, "canCreate": false, "canUpdate": false, "canDelete": false },
            { "entity": "Almacen", "canRead": true, "canCreate": false, "canUpdate": false, "canDelete": false }
          ] }
      ],
      "plan": { "description": "Inventario 1.3.0", "operations": [
        { "op": "setWebhooks", "entity": "Existencia", "webhooks": [
            { "name": "ExistenciaActualizada", "label": "Existencia actualizada",
              "description": "La escribe el motor al aplicar movimientos; la tienda recibe almacén, producto y cantidad.",
              "events": [{ "on": "create" }, { "on": "update" }], "role": "Integración de tienda",
              "fields": ["Almacen", "Producto", "Cantidad", "BajoMinimo"] }
          ] }
      ] } },
    { "version": "1.4.0",
      "description": "Multi-empresa: existencias, movimientos y traspasos son de cada empresa. Una recepción mueve las existencias de su propia empresa; los productos se comparten.",
      "plan": { "description": "Inventario 1.4.0: empresas", "operations": [
        { "op": "updateEntity", "entity": "Existencia", "perCompany": true },
        { "op": "updateEntity", "entity": "MovimientoInventario", "perCompany": true },
        { "op": "updateEntity", "entity": "Traspaso", "perCompany": true }
      ] } },
    { "version": "1.5.0",
      "description": "Costo de entrada: la recepción calcula el costo unitario de cada partida en la moneda base (CONVERT a la fecha de la recepción; sin tipo de cambio, el de la orden) y la entrada al almacén lo recibe. Las entradas y ajustes manuales capturan su costo unitario y los traspasos entran al destino al costo de origen.",
      "plan": { "description": "Inventario 1.5.0: costo de entrada", "operations": [
        { "op": "addField", "entity": "OrdenCompra", "field": { "name": "MonedaClave", "label": "Clave de la moneda", "type": "formula", "resultType": "text", "showInList": false, "formula": "Moneda.Clave" } },
        { "op": "addField", "entity": "Recepcion", "field": { "name": "Moneda", "label": "Moneda de la orden", "type": "text", "maxLength": 10, "showInList": false, "editable": false, "defaultValue": "OrdenCompra.MonedaClave" } },
        { "op": "addField", "entity": "RecepcionPartida", "field": { "name": "CostoUnitario", "label": "Costo unitario (moneda base)", "type": "formula", "resultType": "decimal", "precision": 18, "scale": 4,
            "formula": "ROUND(COALESCE(CONVERT(PartidaOrden.PrecioUnitario * (1 - PartidaOrden.DescuentoPct / 100), Recepcion.Moneda, BASECURRENCY(), Recepcion.Fecha), PartidaOrden.CostoMXN), 4)" } },
        { "op": "addField", "entity": "RecepcionPartida", "field": { "name": "Costo", "label": "Costo (moneda base)", "type": "formula", "resultType": "decimal", "precision": 18, "scale": 2, "formula": "ROUND(Cantidad * CostoUnitario, 2)" } },
        { "op": "addField", "entity": "Recepcion", "field": { "name": "CostoTotal", "label": "Costo total (moneda base)", "type": "formula", "resultType": "decimal", "precision": 18, "scale": 2, "formula": "SUM(Partidas.Costo)" } },
        { "op": "addField", "entity": "MovimientoInventario", "field": { "name": "CostoUnitario", "label": "Costo unitario", "type": "decimal", "precision": 18, "scale": 4 } },
        { "op": "setRules", "entity": "MovimientoInventario", "rules": [
            { "name": "CantidadNoCero", "field": "Cantidad", "assert": "Cantidad <> 0", "message": "La cantidad no puede ser cero." },
            { "name": "SoloAjusteNegativo", "field": "Cantidad", "when": "Tipo <> 'Ajuste'", "assert": "Cantidad > 0", "message": "La cantidad debe ser mayor a cero (solo un ajuste puede ser negativo)." },
            { "name": "AjusteSupervisor", "field": "Tipo", "when": "Tipo = 'Ajuste'", "assert": "HASROLE('Supervisor de inventario') OR HASROLE('Administrador')",
              "message": "Solo el supervisor de inventario registra ajustes." },
            { "name": "TraspasoConDocumento", "field": "Tipo", "when": "Tipo IN ('Traspaso salida', 'Traspaso entrada')", "assert": "NOT ISBLANK(Referencia)",
              "message": "Los traspasos se registran con un documento de traspaso." },
            { "name": "CostoNoNegativo", "field": "CostoUnitario", "assert": "CostoUnitario >= 0", "message": "El costo unitario no puede ser negativo." }
          ] },
        { "op": "setAutomations", "entity": "Recepcion", "merge": true, "automations": [
            { "name": "EntradaAlmacen", "label": "Registrar la entrada al almacén", "on": "enterState", "state": "Confirmada",
              "actions": [
                { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                    { "field": "Tipo", "value": "'Entrada'" }, { "field": "Almacen", "value": "Recepcion.Almacen" },
                    { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Recepcion.Folio" },
                    { "field": "CostoUnitario", "value": "CostoUnitario" } ] }
              ] }
          ] },
        { "op": "setAutomations", "entity": "Traspaso", "merge": true, "automations": [
            { "name": "MoverMercancia", "label": "Mover la mercancía entre almacenes", "on": "enterState", "state": "Aplicado",
              "actions": [
                { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                    { "field": "Tipo", "value": "'Traspaso entrada'" }, { "field": "Almacen", "value": "Traspaso.AlmacenDestino" },
                    { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Traspaso.Folio" },
                    { "field": "CostoUnitario", "value": "ROUND(UNITCOST('Existencia', Cantidad, Traspaso.AlmacenOrigen, Producto), 4)" } ] },
                { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                    { "field": "Tipo", "value": "'Traspaso salida'" }, { "field": "Almacen", "value": "Traspaso.AlmacenOrigen" },
                    { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Traspaso.Folio" } ] }
              ] }
          ] }
      ] } },
    { "version": "1.6.0",
      "description": "Políticas de la recepción (spec 022): sin tipo de cambio a su fecha no se confirma (regla «TipoCambioDeLaRecepcion»; quitarla usa el de la orden, solo con moneda base MXN); ninguna partida confirmada queda sin costo; y la entrada al almacén lleva la fecha de la recepción, la misma de su tipo de cambio y su póliza.",
      "plan": { "description": "Inventario 1.6.0: políticas de la recepción", "operations": [
        { "op": "updateField", "entity": "RecepcionPartida", "field": "CostoUnitario",
          "formula": "ROUND(COALESCE(CONVERT(PartidaOrden.PrecioUnitario * (1 - PartidaOrden.DescuentoPct / 100), Recepcion.Moneda, BASECURRENCY(), Recepcion.Fecha), IF(BASECURRENCY() = 'MXN', PartidaOrden.CostoMXN, NULL)), 4)" },
        { "op": "setRules", "entity": "Recepcion", "merge": true, "rules": [
            { "name": "TipoCambioDeLaRecepcion", "field": "Fecha", "when": "Estado = 'Confirmada'",
              "assert": "NOT ISBLANK(RATE(COALESCE(Moneda, OrdenCompra.MonedaClave), BASECURRENCY(), Fecha))",
              "message": "No hay tipo de cambio de la moneda de la orden a la moneda base en o antes de la fecha de la recepción: regístralo en Configuración › Empresas › Tipos de cambio antes de confirmar." }
          ] },
        { "op": "setRules", "entity": "RecepcionPartida", "merge": true, "rules": [
            { "name": "CostoCalculado", "field": "CostoUnitario", "when": "Recepcion.Estado = 'Confirmada'", "assert": "NOT ISBLANK(CostoUnitario)",
              "message": "La partida no tiene costo en la moneda base (falta el tipo de cambio): la recepción no se confirma sin costo." }
          ] },
        { "op": "setAutomations", "entity": "Recepcion", "merge": true, "automations": [
            { "name": "EntradaAlmacen", "label": "Registrar la entrada al almacén", "on": "enterState", "state": "Confirmada",
              "actions": [
                { "type": "create", "lines": "Partidas", "entity": "MovimientoInventario", "set": [
                    { "field": "Fecha", "value": "Recepcion.Fecha" },
                    { "field": "Tipo", "value": "'Entrada'" }, { "field": "Almacen", "value": "Recepcion.Almacen" },
                    { "field": "Producto", "value": "Producto" }, { "field": "Cantidad", "value": "Cantidad" }, { "field": "Referencia", "value": "Recepcion.Folio" },
                    { "field": "CostoUnitario", "value": "CostoUnitario" } ] }
              ] }
          ] }
      ] } },
    { "version": "1.6.1",
      "description": "Corrección (spec 022): sin tipo de cambio ni respaldo, el costo unitario de la partida queda vacío en lugar de cero (ROUND de un vacío daba 0), así la regla «CostoCalculado» detiene la confirmación en vez de valuar la entrada a cero.",
      "plan": { "description": "Inventario 1.6.1: costo vacío sin tipo de cambio", "operations": [
        { "op": "updateField", "entity": "RecepcionPartida", "field": "CostoUnitario",
          "formula": "IF(ISBLANK(COALESCE(CONVERT(PartidaOrden.PrecioUnitario * (1 - PartidaOrden.DescuentoPct / 100), Recepcion.Moneda, BASECURRENCY(), Recepcion.Fecha), IF(BASECURRENCY() = 'MXN', PartidaOrden.CostoMXN, NULL))), NULL, ROUND(COALESCE(CONVERT(PartidaOrden.PrecioUnitario * (1 - PartidaOrden.DescuentoPct / 100), Recepcion.Moneda, BASECURRENCY(), Recepcion.Fecha), IF(BASECURRENCY() = 'MXN', PartidaOrden.CostoMXN, NULL)), 4))" }
      ] } },
    { "version": "1.7.0",
