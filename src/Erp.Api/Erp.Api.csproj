<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>erp-ai-api-dev</UserSecretsId>
    <!-- Seguridad de la cadena de suministro: un paquete vulnerable rompe el build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.2.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Fijado: la versión transitiva 9.0.18 tiene vulnerabilidades conocidas (GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erp.Tests" />
    <InternalsVisibleTo Include="Erp.IntegrationTests" />
  </ItemGroup>

  <!-- Spec 027 (ADR-0007): la fuente de los PDF viaja dentro del ensamblado (Lato, SIL OFL 1.1): igual en Windows y Linux. -->
  <ItemGroup>
    <EmbeddedResource Include="Printing\Fonts\*.ttf" LogicalName="Erp.Fonts.%(Filename)%(Extension)" />
    <!-- Spec 033: el registro de riesgos, para el explorador y la herramienta "riesgos" del agente. -->
    <EmbeddedResource Include="..\..\docs\sdd\riesgos.md" LogicalName="riesgos.md" />
  </ItemGroup>

</Project>
